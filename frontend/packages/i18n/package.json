{
  "name": "@retainpdf/i18n",
  "version": "0.1.0",
  "private": false,
  "description": "RetainPDF message catalogs and the runtime t() lookup — shared by the web app and every workspace package.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./messages/zh": {
      "types": "./dist/messages/zh.d.ts",
      "import": "./dist/messages/zh.js"
    },
    "./messages/vi": {
      "types": "./dist/messages/vi.d.ts",
      "import": "./dist/messages/vi.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node ./scripts/clean-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsc --watch -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
